# Base URL for the app under test.
# Defaults to https://roamstay.com (see pyproject.toml) if unset.
PYTEST_BASE_URL=http://localhost:3000

# Per-organization sign-in credentials used by the test suite.
# Each organization is registered in credentials.py; add a matching
# <ORG_ID>_EMAIL / <ORG_ID>_PASSWORD pair here (ORG_ID uppercased).
LIBERTY_EMAIL=your-email@example.com
LIBERTY_PASSWORD=your-password
